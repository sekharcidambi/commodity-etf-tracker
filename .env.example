# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/commodity_tracker

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys - Get your free API keys from:
# Twelve Data: https://twelvedata.com/
# Polygon.io: https://polygon.io/
# Alpha Vantage: https://www.alphavantage.co/
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html

TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Data Collection
ENABLE_SCHEDULER=true
DATA_COLLECTION_ENABLED=false  # Set to true when API keys are configured

# Tickers (comma-separated)
PRIMARY_TICKERS=AGQ,UGL
EXTENDED_TICKERS=ZSL,GLD,SLV,PPLT
FUTURES_SYMBOLS=GC=F,SI=F,PL=F

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
